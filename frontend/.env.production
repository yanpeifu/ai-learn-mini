# ⚠️ 注意：`taro build --type weapp`（即 pnpm build:weapp）默认按**生产模式**编译，
#    读的就是本文件；`pnpm dev:weapp`（带 --watch）才读 .env.development。
#    所以本地联调的地址和开关也必须写在这里，否则改了 .env.development 不会生效。

# 本地联调开关：true = 用 dev_ 假登录（还没有小程序 AppID/Secret 时必须为 true）
# 正式发布前改成 "false"，并配置 WECHAT_APPID / WECHAT_SECRET
TARO_APP_DEV_LOGIN="true"

# 后端地址：本地/真机联调用电脑局域网 IP；部署后改成 https 域名（需已备案）
# ⚠️ 这个 IP 会随路由器 DHCP 变化，已经改过好几次：
#    192.168.2.92 → 192.168.0.222 → 10.129.0.222 → 192.168.2.53 → 2026-09-23 192.168.2.148
#    连不上时先跑 `ipconfig | Select-String IPv4` 查当前 IP，改这里后重新编译。
#    现已加入「备用地址」机制：主地址连不上会自动切到 TARO_APP_API_FALLBACK，
#    因此模拟器场景不必再跟着 IP 改来改去，只有真机测试时才需要更新上面的 IP。
TARO_APP_API_BASE="http://192.168.2.148:8000"

# 备用后端地址（模拟器与后端在同一台电脑，127.0.0.1 永远可达）
TARO_APP_API_FALLBACK="http://127.0.0.1:8000"
