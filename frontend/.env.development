# 配置文档参考 https://taro-docs.jd.com/docs/next/env-mode-config
# 说明：本文件只在 `pnpm dev:weapp`（带 --watch）时生效；
#       `pnpm build:weapp` 读的是 .env.production，两处都要保持一致。
# 本地联调开关：true = 用 dev_ 假登录（还没有小程序 AppID/Secret 时必须为 true）
# 拿到 AppID/Secret 后改成 false，前端就会走真实的 wx.login + code2session
TARO_APP_DEV_LOGIN="true"
# TARO_APP_ID="开发环境下的小程序 AppID"

# # 开发期后端地址（本机后端默认端口 8000；真机联调时改成电脑局域网 IP）
# TARO_APP_API_BASE="http://127.0.0.1:8000"
TARO_APP_API_BASE="http://192.168.2.92:8000"
