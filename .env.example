# ============================================================
#  环境变量配置模板
# ------------------------------------------------------------
#  用法：把本文件复制一份，改名为 .env，然后把 Key 换成你自己的。
#
#      PowerShell:   Copy-Item .env.example .env
#      资源管理器:   复制 .env.example → 粘贴 → 重命名为 .env
#
#  .env 已被 .gitignore 排除，不会被提交到 Git，可以放心填写。
# ============================================================

# ------------------------------------------------------------
# 【必填】你的 API Key
# 获取地址：https://platform.deepseek.com  →  左侧菜单「API Keys」
# 注意：Key 只在创建时完整显示一次，请立即复制
# ------------------------------------------------------------
DEEPSEEK_API_KEY=sk-替换成你自己的key

# 也可以用下面这个变量名，效果完全相同（二选一，不要都填）
# LLM_API_KEY=sk-替换成你自己的key

# ------------------------------------------------------------
# 【选填】以下三项保持默认即可，一般不需要改动
# ------------------------------------------------------------

# 接口地址（任何兼容 OpenAI 格式的服务都可以）
LLM_BASE_URL=https://api.deepseek.com

# 模型名
LLM_MODEL=deepseek-flash

# 单次请求超时（秒）。网络慢或模型响应慢时调大
LLM_TIMEOUT=180

# ------------------------------------------------------------
# 【选填】联网检索（Tavily）
# 用途：让 AI 在出题前先去网上找资料，避免模型没学过的知识被答错
# 不填 API Key = 关闭检索，其它功能不受影响
# 获取地址：https://app.tavily.com  →  API Keys
# ------------------------------------------------------------
TAVILY_API_KEY=xxx

# 检索模式：auto = 需要时才搜（推荐）；always = 每次都搜；off = 完全关闭
SEARCH_MODE=auto

# 以下保持默认即可，一般不需要改动

# 单次检索超时（秒）
SEARCH_TIMEOUT=20

# 一次检索返回条数的下限 / 上限（简单知识取下限，复杂知识取上限）
SEARCH_MAX_RESULTS_MIN=3
SEARCH_MAX_RESULTS_MAX=8

# 一次生成最多用几个检索词
SEARCH_MAX_QUERIES=3

# 注入提示词的资料预算（字符数，不是输入框的字数校验）
SEARCH_CONTEXT_MAX_CHARS=20000

# 单用户每日检索次数上限
DAILY_SEARCH_QUOTA=30

# 地域偏置：填小写英文国家名（如 china），留空 = 不偏置；仅普通网页检索生效
SEARCH_COUNTRY=

# 优先来源站点（逗号分隔），留空 = 不限
SEARCH_PREFERRED_DOMAINS=
